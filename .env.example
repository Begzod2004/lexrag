# ===== LexRAG sozlamalari: shu faylni .env deb nusxalang va kalitlarni yozing =====

# --- Tester uchun API kalit(lar) (vergul bilan). Bo'sh bo'lsa — API ochiq (faqat lokal test!) ---
LEXRAG_API_KEYS=test-kalit-bu-yerga

# --- LLM: asosiy — Claude (eng kuchli). Kalit: https://console.anthropic.com ---
ANTHROPIC_API_KEY=
# javob generatsiyasi
CLAUDE_ANSWER_MODEL=claude-sonnet-5-5
# so'rov tahlili + rerank (tez)
CLAUDE_FAST_MODEL=claude-haiku-5-5

# --- OpenAI: embedding uchun (va Claude ishlamasa fallback LLM) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ANSWER_MODEL=gpt-5.6-sol
OPENAI_FAST_MODEL=gpt-5.6-luna

# --- Kursdagi lokal Qwen (vLLM, OpenAI-mos) — oxirgi fallback ---
QWEN_BASE_URL=http://10.20.9.24:8000/v1
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3-8B-AWQ

# auto | anthropic | openai | qwen
LLM_PROVIDER=auto
LLM_FALLBACK=true
LLM_TIMEOUT_S=60

# --- Embedding ---
# openai | st (lokal sentence-transformers) | hash (test) | none (faqat BM25)
EMBEDDING_PROVIDER=openai
# st uchun: BAAI/bge-m3
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMS=1024
# float16 — xotira 2 baravar kam, biroz sekin
DENSE_DTYPE=float32

# --- Qidiruv ---
# RRF silliqlash konstantasi: kichik = 1-o'rinlar ustun, katta = ko'p ro'yxatda topilgan ustun
RRF_K=60
# LLM so'rov tahlili (uz/ru qayta yozish, HyDE, hujjat ishoralari)
QUERY_REWRITE=true
# llm | cross_encoder | none
RERANKER=llm
# rerankga beriladigan nomzodlar
LEXRAG_POOL_SIZE=40
# generatsiyaga beriladigan manbalar
LEXRAG_GEN_K=8
# past ballli kontekstlarni qo'shmaslik (precision uchun)
ADAPTIVE_CONTEXTS=true
MIN_CONTEXTS=3
MIN_CONTEXT_SCORE=0.35
# canonical (o'zbekcha ID) | by_language (rus savolga rus ID)
DOC_ID_MODE=canonical

# --- Server ---
LEXRAG_DATA_DIR=data
LEXRAG_RATE_LIMIT_PER_SEC=5
LEXRAG_RATE_LIMIT_BURST=10
LEXRAG_SYNC_TIMEOUT_S=110
LEXRAG_MAX_PARALLEL=10
LEXRAG_ANSWER_CACHE=true

# --- Crawler ---
CRAWL_DELAY_S=0.4
CRAWL_WORKERS=3
CRAWL_LANGUAGES=uz-Cyrl,uz-Latn,ru
